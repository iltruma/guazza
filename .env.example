# Guazza — template variabili d'ambiente
# Copia in .env e compila con i valori reali. NON committare .env.

# ── Netatmo OAuth2 (job realtime) ─────────────────────────────────────────────
# Credenziali app: https://dev.netatmo.com/apps
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
NETATMO_ACCESS_TOKEN=
NETATMO_REFRESH_TOKEN=

# ── Monitoring ────────────────────────────────────────────────────────────────
# URL base ping Healthchecks.io (dead-man switch). Se vuoto, il ping è saltato.
HEALTHCHECKS_URL=

# ── Storage ───────────────────────────────────────────────────────────────────
# Path del file DuckDB. Default: /var/lib/guazza/guazza.duckdb
DB_PATH=

# Directory dei file YAML di configurazione. Default: <repo>/config
CONFIG_DIR=
