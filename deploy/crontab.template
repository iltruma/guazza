# Guazza — crontab template
#
# Installazione sul VPS:
#   crontab deploy/crontab.template
#
# Prerequisiti:
#   - uv installato e in PATH
#   - Repo clonato in /opt/guazza con `uv sync` eseguito
#   - .env compilato in /opt/guazza/.env (Netatmo, Healthchecks)
#   - DB_PATH e HEALTHCHECKS_URL esportati (o in .env)
#
# Logging: ogni job scrive JSON su stdout, rediretto in /var/log/guazza/<job>.jsonl
# Logrotate consigliato: rotation daily, retention 30 days.
#
# Lock DuckDB (KI001): single writer alla volta.
# I job sono schedulati con gap sufficienti per non sovrapporsi.
# Il lock file in storage.py serializza comunque in caso di overlap accidentale.

SHELL=/bin/bash
PATH=/home/guazza/.local/bin:/usr/local/bin:/usr/bin:/bin
GUAZZA_DIR=/opt/guazza

# Variabili d'ambiente per i job
DB_PATH=/var/lib/guazza/guazza.duckdb
# HEALTHCHECKS_URL=https://hc-ping.com/<uuid>  # decommentare e compilare

# ── Ogni 15 min: realtime (SIR actions.php + Netatmo) ─────────────────────────
# SIR aggiorna ogni ~15 min, Netatmo ogni ~10 min.
# Offset :02 per evitare il minuto esatto (carico infrastruttura)
2,17,32,47 * * * *   cd $GUAZZA_DIR && uv run python -m guazza.jobs.ingest realtime >> /var/log/guazza/realtime.jsonl 2>&1

# ── Ogni 6 ore: forecast NWP (Open-Meteo multi-modello) ──────────────────────
# Allineato ai run ECMWF (00/06/12/18 UTC) + lag ~2h per disponibilità dati.
# Esecuzione a 02:10, 08:10, 14:10, 20:10 UTC.
10 2,8,14,20 * * *   cd $GUAZZA_DIR && uv run python -m guazza.jobs.ingest forecasts >> /var/log/guazza/forecasts.jsonl 2>&1

# ── Ogni giorno alle 06:00 UTC: delta giornaliero (SIR CSV + Open-Meteo ieri) ─
# SIR pubblica i dati validati del giorno precedente entro le 03:00-05:00 UTC.
0 6 * * *   cd $GUAZZA_DIR && uv run python -m guazza.jobs.ingest daily >> /var/log/guazza/daily.jsonl 2>&1

# ── FUTURI (decommentare quando implementati) ─────────────────────────────────

# Backup DuckDB → Cloudflare R2 (ogni notte alle 03:00)
# 0 3 * * *   cd $GUAZZA_DIR && uv run python -m guazza.jobs.backup >> /var/log/guazza/backup.jsonl 2>&1

# Validazione accuracy (ogni giorno alle 08:00, dopo che obs della notte sono disponibili)
# 0 8 * * *   cd $GUAZZA_DIR && uv run python -m guazza.jobs.validate >> /var/log/guazza/validate.jsonl 2>&1

# Retraining LightGBM (domenica notte 02:00)
# 0 2 * * 0   cd $GUAZZA_DIR && uv run python -m guazza.jobs.retrain >> /var/log/guazza/retrain.jsonl 2>&1
