# Guazza — crontab template
#
# Installazione sul VPS:
#   crontab deploy/crontab.template
#
# Prerequisiti:
#   - uv installato in /home/guazza/.local/bin/uv (o PATH configurato)
#   - Package guazza installato: uv sync
#   - .env compilato in /opt/guazza/.env
#   - Directory log esistenti: /var/log/guazza/
#
# Convenzione log: ogni job scrive su /var/log/guazza/<job>.log
# con rotazione via logrotate (vedi deploy/logrotate.conf — da creare).
#
# Healthchecks.io: ogni job pinga l'URL /start all'inizio e l'URL base al termine.
# Se il job non termina, Healthchecks.io manda notifica dopo il timeout configurato.

SHELL=/bin/bash
PATH=/home/guazza/.local/bin:/usr/local/bin:/usr/bin:/bin
GUAZZA_DIR=/opt/guazza

# ── Ogni ora: ingestion real-time (CFR + idrometria) ─────────────────────────
# Offset di 5 minuti per non collidere con job 6h
5 * * * *   guazza  cd $GUAZZA_DIR && uv run guazza-ingest-realtime >> /var/log/guazza/ingest_realtime.log 2>&1

# ── Ogni 6 ore: ingestion NWP (Open-Meteo) + inference ML ────────────────────
# Eseguiti in sequenza: prima ingestion, poi predict
# 00:10, 06:10, 12:10, 18:10
10 0,6,12,18 * * *   guazza  cd $GUAZZA_DIR && uv run guazza-ingest-forecasts --location casa_campi    >> /var/log/guazza/ingest_forecasts.log 2>&1
11 0,6,12,18 * * *   guazza  cd $GUAZZA_DIR && uv run guazza-ingest-forecasts --location lavoro_cosimo >> /var/log/guazza/ingest_forecasts.log 2>&1
12 0,6,12,18 * * *   guazza  cd $GUAZZA_DIR && uv run guazza-ingest-forecasts --location lavoro_madda  >> /var/log/guazza/ingest_forecasts.log 2>&1
13 0,6,12,18 * * *   guazza  cd $GUAZZA_DIR && uv run guazza-ingest-forecasts --location casa_cesto    >> /var/log/guazza/ingest_forecasts.log 2>&1
30 0,6,12,18 * * *   guazza  cd $GUAZZA_DIR && uv run guazza-predict >> /var/log/guazza/predict.log 2>&1

# ── Ogni 24 ore: qualità aria ARPAT ──────────────────────────────────────────
45 7 * * *   guazza  cd $GUAZZA_DIR && uv run guazza-ingest-realtime --source arpat >> /var/log/guazza/ingest_arpat.log 2>&1

# ── Ogni 24 ore: validazione accuracy ────────────────────────────────────────
# Eseguita alle 08:00, quando le osservazioni della notte sono disponibili
0 8 * * *   guazza  cd $GUAZZA_DIR && uv run guazza-validate >> /var/log/guazza/validate.log 2>&1

# ── Ogni 24 ore: backup DuckDB → Cloudflare R2 ───────────────────────────────
# Ore 03:00 — traffico minimo, dopo ingestion notturna
0 3 * * *   guazza  cd $GUAZZA_DIR && uv run guazza-backup >> /var/log/guazza/backup.log 2>&1

# ── Settimanale: retraining LightGBM ─────────────────────────────────────────
# Domenica notte ore 02:00 — dopo backup, prima di ingestion
0 2 * * 0   guazza  cd $GUAZZA_DIR && uv run guazza-retrain >> /var/log/guazza/retrain.log 2>&1

# ── Nota sui gap tra job ──────────────────────────────────────────────────────
# Workaround KI001 (DuckDB single writer): i job che scrivono su DuckDB
# sono schedulati con gap di almeno 1 minuto tra loro.
# ingest_forecasts (4 location): minuti 10-13
# predict: minuto 30 (17 minuti dopo l'ultimo ingest)
# I job orari (ingest_realtime) partono al minuto 5: nessuna sovrapposizione
# con i job 6h (che partono al minuto 10+).
