# Guazza — Caddy configuration
# Alternativa a Nginx: Caddy gestisce SSL automatico via Let's Encrypt.
# Con Tailscale Funnel attivo SSL è terminato a monte e Caddy può servire solo HTTP
# (rimuovere i blocchi TLS o servire in chiaro sulla porta locale).
#
# Attivazione:
#   sudo apt install caddy
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

guazza.it {
    # Ridirigi www → apex
    @www host www.guazza.it
    redir @www https://guazza.it{uri} permanent

    # Health check
    respond /health "OK" 200

    # Dashboard HTML statica
    root * /var/www/guazza/html
    file_server

    # JSON previsioni
    handle /data/* {
        root * /var/www/guazza
        file_server
        header Access-Control-Allow-Origin "*"
        header Cache-Control "public, max-age=300"
    }

    # Log strutturati (JSON)
    log {
        output file /var/log/guazza/caddy_access.log
        format json
    }

    # Blocca accesso a file nascosti
    @hidden path_regexp hidden /\..*
    respond @hidden 403
}
