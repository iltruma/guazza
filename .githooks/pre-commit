#!/usr/bin/env bash
# Pre-commit hook: ruff check + mypy + pytest smoke
# Installazione: cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# (oppure: git config core.hooksPath .githooks)
set -euo pipefail

echo "--- pre-commit: ruff ---"
uv run ruff check src/ tests/

echo "--- pre-commit: mypy ---"
uv run mypy src/

echo "--- pre-commit: pytest (smoke) ---"
uv run pytest -x -q --tb=short

echo "--- pre-commit: OK ---"
